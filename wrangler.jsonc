{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "statusteam",
  "compatibility_date": "2026-08-11",

  // Assets-only Worker: there is no `main` script, so Cloudflare serves the
  // exported files straight from the edge and no Worker runs per request.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "statusss",
      "database_id": "279263e3-26d6-4614-8cbf-80eec0fe18a9"
    }
  ]
}
