{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "statusteam",
  "compatibility_date": "2026-08-11",

  // Assets-only Worker: there is no `main` script, so Cloudflare serves the
  // exported files straight from the edge and no Worker runs per request.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
