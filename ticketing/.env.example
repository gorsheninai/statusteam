# Run only locally with mock. No real payments or valid admission tickets.
PAYMENT_PROVIDER=mock
TICKETING_BASE_URL=http://127.0.0.1:4320
TICKETING_HOST=127.0.0.1
# Enable only behind our loopback Nginx, which overwrites X-Real-IP.
TICKETING_TRUST_PROXY=0
PORT=4320
TICKETING_DB=./data/tickets.sqlite
# Set a random password with 24+ characters. Username is staff.
TICKETING_STAFF_PASSWORD=
# Optional catalog JSON file, prices in kopecks. Defaults to a clearly marked demo.
TICKETING_CATALOG=
# For PAYMENT_PROVIDER=yookassa-test only. Never put keys in NEXT_PUBLIC_*.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Optional SMTP URL and sender. No success is reported if SMTP is not configured.
SMTP_URL=
MAIL_FROM=
